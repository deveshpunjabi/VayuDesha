# VayuDesha — Environment Configuration Example
# Copy to .env for local development. Never commit real secrets to Git.

# Server port (Google Cloud Run sets PORT=8080 automatically)
PORT=8080

# Google Gemini API (Primary GenAI Structured-JSON Router)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# OpenAQ API v3 (Live Observed Physical Ground Stations — https://explore.openaq.org/register)
OPENAQ_API_KEY=

# Optional Secondary Providers
WAQI_API_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_PROVIDER=gemini
AI_DAILY_REQUEST_CAP=80
