# AirWise runs in rules-only mode without any API credential.
# These values are SERVER-ONLY. Never commit .env or expose any key in the browser.

# Optional Google Gemini structured-JSON router (used by default when set)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional OpenAI Responses API structured-JSON router (set AI_PROVIDER=openai to prefer OpenAI when both keys exist)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# AI_PROVIDER=gemini

# Optional WAQI ground-station comparison feed (keeps Copernicus CAMS model data separate from observed stations)
WAQI_API_TOKEN=

# Safety & runtime settings
AI_DAILY_REQUEST_CAP=80
PORT=3000
