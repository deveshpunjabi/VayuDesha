# Optional server-side environment variables for VayuDesha.
# Copy to .env locally (never commit .env to Git).

# Google Gemini API (used by default when set)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# OpenAI Responses API (optional alternative; set AI_PROVIDER=openai to prefer when both keys exist)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_PROVIDER=

# Optional OpenAQ v3 observed ground-station API key (register free at https://explore.openaq.org/register)
OPENAQ_API_KEY=

# Optional WAQI observed ground-station comparison token
WAQI_API_TOKEN=

# Per-process daily AI request cap & local server port
AI_DAILY_REQUEST_CAP=80
PORT=3000
